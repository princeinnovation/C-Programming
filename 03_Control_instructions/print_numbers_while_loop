// Program to print numbers from 0 to N using a while loop.
#include<stdio.h>
int main(){
    int num;
    int i = 1;
        printf("Enter how much numbers you want to write: ");
    scanf("%d",&num);

    if(num < 1){
        printf("Please enter a non negative number");
    }
    
    else{
        while ( i <= num)
        {
            printf("%d\n",i);
            i++;
        }
    }

    return 0;
}
